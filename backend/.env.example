# ==============================================================================
# Antarctic AI Decision Support System - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# DEMO_MODE:
# When set to true, the system runs with authentic synthetic Antarctic datasets.
# No external NASA, Copernicus, or Weather API keys are required.
# Set to false to enable live remote sensing data ingestion pipelines.
DEMO_MODE=true

# Supabase Project Credentials
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SECRET_KEY=your-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase PostgreSQL Connection String
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use psycopg driver prefix: postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# Application Secret Key
SECRET_KEY=polar_decision_support_secret_key_change_in_production

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Optional External Remote Sensing & Meteorological Credentials
# (Only needed if DEMO_MODE=false; leave blank for standard local runs)
# ------------------------------------------------------------------------------

# NASA Earthdata (NSIDC Sea-Ice Concentration data products)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# Copernicus Marine Environment Monitoring Service (CMEMS Ocean & Sea Ice)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# External Metocean API (OpenWeatherMap / WeatherAPI / Tomorrow.io)
WEATHER_API_KEY=

# Mapbox Access Token (Optional, for custom vector basemaps)
MAPBOX_ACCESS_TOKEN=
